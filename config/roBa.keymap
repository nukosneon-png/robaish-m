#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <0>;
    tapping-term-ms = <150>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "tap-preferred";
    tapping-term-ms = <175>;
};

&trackball {
    automouse-layer = <MOUSE>;
    scroll-layers = <SCROLL>;
};

/ {
    macros {
        kana_exit_aml: kana_exit_aml {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&kp LANG1 &tog_off MOUSE>;
        };

        eisu_exit_aml: eisu_exit_aml {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&kp LANG2 &tog_off MOUSE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        shita {
            bindings = <&kp DOWN>;
            key-positions = <30 31>;
        };

        ue {
            bindings = <&kp UP_ARROW>;
            key-positions = <6 7>;
        };

        ctrlz {
            bindings = <&kp LC(Z)>;
            key-positions = <40 18>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <39 40>;
        };

        combo_lang2 {
            bindings = <&eisu_exit_aml>;
            key-positions = <13 12>;
            layers = <0 MOUSE>;
            timeout-ms = <100>;
        };

        combo_lang1 {
            bindings = <&kana_exit_aml>;
            key-positions = <19 18>;
            layers = <0 MOUSE>;
            timeout-ms = <100>;
        };
    };

    behaviors {
        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_UP_DOWN";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <40>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RIGHT_LEFT";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <40>;
        };

        ctrl_zoom: ctrl_zoom {
            compatible = "zmk,behavior-sensor-rotate";
            label = "CTRL_ZOOM";
            #sensor-binding-cells = <0>;
            bindings = <&kp LC(MINUS)>, <&kp LC(EQUAL)>;

            tap-ms = <40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // roBaish Row1 has 12 keys (extra left thumb at pos 15)
            // moNa2 Row1 has 11 keys
            // pos 15 = extra key on roBaish, mapped to &none (unused)

            bindings = <
&kp Q           &kp F   &kp L         &kp EXCLAMATION       &kp AT_SIGN                                   &kp Z        &kp R  &kp Y  &kp W  &kp P
&kp O           &kp E   &kp U         &kp I                 &kp MINUS    &trans            &kp LEFT_WIN   &kp K        &kp T  &kp N  &kp S  &kp H
&sk LEFT_SHIFT  &kp X   &kp C         &kp V                 &kp COLON    &kp TAB           &kp DELETE     &kp G        &kp D  &kp M  &kp J  &kp B
&kp LCTRL       &trans  &kp LEFT_ALT  &mt LEFT_SHIFT COMMA  &lt 3 A      &lt 2 PERIOD      &kp BACKSPACE  &lt 1 SPACE                       &kp ENTER
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                            &kp EQUAL  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PERCENT
&trans  &trans  &trans  &trans  &trans  &trans      &kp KP_PLUS   &kp ASTRK  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0
&trans  &trans  &trans  &trans  &trans  &trans      &kp KP_MINUS  &kp SLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COMMA
&trans  &trans  &trans  &trans  &trans  &trans      &trans        &trans                                               &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
&trans  &trans            &trans         &trans            &kp LC(PLUS)                       &trans  &trans  &trans  &trans  &trans
&trans  &kp LA(NUMBER_2)  &kp LC(LS(L))  &kp LA(NUMBER_1)  &kp LC(MINUS)  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans            &trans         &trans            &trans         &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans            &trans         &trans            &trans         &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        layer_3 {
            bindings = <
&trans     &kp DOUBLE_QUOTES  &kp SQT          &kp LC(LS(V))  &trans                                     &trans            &trans                &trans                 &trans  &trans
&kp LC(A)  &kp AMPERSAND      &kp EXCLAMATION  &kp QUESTION   &kp UNDER  &trans               &trans     &trans            &kp LEFT_ARROW        &kp RIGHT              &trans  &trans
&trans     &kp DOLLAR         &kp LC(C)        &kp LC(V)      &trans     &kp PRINTSCREEN      &trans     &trans            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans
&trans     &trans             &trans           &trans         &trans     &trans               &kp MINUS  &kp GREATER_THAN                                                       &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB2  &trans  &mo SCROLL
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
